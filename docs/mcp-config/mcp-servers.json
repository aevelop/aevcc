{
  "mcpServers": {
    "clickhouse": {
      "description": "ClickHouse analytics queries",
      "type": "http",
      "url": "https://mcp.clickhouse.cloud/mcp"
    },
    "cloudflare-docs": {
      "description": "Cloudflare documentation search",
      "type": "http",
      "url": "https://docs.mcp.cloudflare.com/mcp"
    },
    "cloudflare-observability": {
      "description": "Cloudflare observability/logs",
      "type": "http",
      "url": "https://observability.mcp.cloudflare.com/mcp"
    },
    "cloudflare-workers-bindings": {
      "description": "Cloudflare Workers bindings",
      "type": "http",
      "url": "https://bindings.mcp.cloudflare.com/mcp"
    },
    "cloudflare-workers-builds": {
      "description": "Cloudflare Workers builds",
      "type": "http",
      "url": "https://builds.mcp.cloudflare.com/mcp"
    },
    "filesystem": {
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "$HOME/Documents/GitHub"
      ],
      "command": "npx",
      "description": "Filesystem operations (set your path)"
    },
    "firecrawl": {
      "args": [
        "-y",
        "firecrawl-mcp"
      ],
      "command": "npx",
      "description": "Web scraping and crawling",
      "env": {
        "FIRECRAWL_API_KEY": "${FIRECRAWL_API_KEY}"
      }
    },
    "github": {
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "command": "npx",
      "description": "GitHub operations - PRs, issues, repos",
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },
    "magic": {
      "args": [
        "-y",
        "@magicuidesign/mcp@latest"
      ],
      "command": "npx",
      "description": "Magic UI components"
    },
    "memory": {
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory"
      ],
      "command": "npx",
      "description": "Persistent memory across sessions"
    },
    "notebooklm": {
      "args": [
        "notebooklm-mcp@latest"
      ],
      "command": "npx",
      "env": {},
      "type": "stdio"
    },
    "obsidian": {
      "args": [
        "@mauricio.wolff/mcp-obsidian@latest",
        "$HOME/Desktop/Page-Fixes/test-obsidian"
      ],
      "command": "npx",
      "env": {}
    },
    "playwright": {
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ],
      "command": "npx",
      "env": {
        "HEADED": "${HEADED}"
      },
      "type": "stdio"
    },
    "railway": {
      "args": [
        "-y",
        "@railway/mcp-server"
      ],
      "command": "npx",
      "description": "Railway deployments"
    },
    "sequential-thinking": {
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "command": "npx",
      "description": "Chain-of-thought reasoning"
    },
    "stitch": {
      "headers": {
        "X-Goog-Api-Key": "${STITCH_X_GOOG_API_KEY}"
      },
      "type": "http",
      "url": "https://stitch.googleapis.com/mcp"
    },
    "supabase": {
      "args": [
        "-y",
        "@supabase/mcp-server-supabase@latest",
        "--project-ref=YOUR_PROJECT_REF"
      ],
      "command": "npx",
      "description": "Supabase database operations"
    },
    "vercel": {
      "description": "Vercel deployments and projects",
      "type": "http",
      "url": "https://mcp.vercel.com"
    },
    "lottiefiles-creator": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@lottiefiles/creator-mcp@latest"
      ],
      "env": {}
    },
    "rive": {
      "type": "http",
      "url": "http://127.0.0.1:9791/mcp"
    },
    "figcraft": {
      "type": "stdio",
      "command": "$HOME/.local/bin/figcraft-cli",
      "args": [
        "mcp"
      ],
      "env": {}
    },
    "design-library": {
      "type": "stdio",
      "command": "node",
      "args": [
        "$HOME/Desktop/Page-Fixes/part/b/design-library/src/cli.ts",
        "mcp"
      ],
      "env": {}
    }
  }
}
